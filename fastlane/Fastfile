require_relative 'apple_store_processing'

default_platform(:android)

platform :android do
  desc "Upload the signed Pleazyng App Bundle to the selected Google Play track."
  lane :publish_play_store do
    upload_to_play_store(
      aab: ENV.fetch("PLAY_AAB_PATH"),
      package_name: "org.snapetech.pleazyng",
      json_key_data: ENV.fetch("SUPPLY_JSON_KEY_DATA"),
      track: ENV.fetch("PLAY_TRACK", "internal"),
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "draft"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the signed Pleazyng Fire TV APK to Amazon Appstore without submitting it for review."
  lane :publish_amazon_appstore do
    app_id = ENV.fetch("AMAZON_APPSTORE_APP_ID")
    unless app_id.match?(/\Aamzn1\.devportal\.mobileapp\.[0-9a-f]{32}\z/)
      raise "AMAZON_APPSTORE_APP_ID must be the Amazon console App ID, not the Android package name."
    end
    upload_to_amazon_appstore(
      # Plugin 1.7.0 forwards this misleadingly named option as the API app_id.
      package_name: app_id,
      apk: ENV.fetch("AMAZON_APK_PATH"),
      client_id: ENV.fetch("AMAZON_CLIENT_ID"),
      client_secret: ENV.fetch("AMAZON_CLIENT_SECRET"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      overwrite_upload: true,
      overwrite_upload_mode: "reuse",
      changes_not_sent_for_review: true
    )
  end
end

platform :ios do
  desc "Upload a signed iOS or tvOS Pleazyng IPA to App Store Connect without submitting it for review."
  lane :upload_appstore_build do
    ipa = ENV.fetch('APPLE_IPA_PATH')
    release_tag = ENV.fetch('APPLE_RELEASE_TAG')
    expected = AppleStoreProcessing.expected(
      plist: FastlaneCore::IpaFileAnalyser.fetch_info_plist_file(ipa),
      platform: ENV.fetch('APPLE_STORE_PLATFORM'), release_tag: release_tag
    )
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_API_ISSUER_ID"),
      key_content: ENV.fetch("APPLE_API_PRIVATE_KEY"),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    app = Spaceship::ConnectAPI.get_app(app_id: expected[:app_id]).first
    AppleStoreProcessing.verify_app!(app)
    fetch = lambda do |identity|
      token = Spaceship::ConnectAPI.token
      token.refresh! if token&.expired?
      Spaceship::ConnectAPI::Build.all(
        app_id: identity[:app_id], version: identity[:version],
        build_number: identity[:build], platform: identity[:platform]
      )
    end
    upload = lambda do
      upload_to_app_store(
        api_key: api_key,
        ipa: ipa,
        app_identifier: expected[:bundle_id],
        platform: ENV.fetch('APPLE_STORE_PLATFORM'),
        force: true,
        skip_metadata: true,
        skip_screenshots: true,
        skip_app_version_update: true,
        submit_for_review: false,
        automatic_release: false
      )
    end
    build, uploaded = AppleStoreProcessing.wait_for_valid(
      expected: expected, fetch: fetch, upload: upload,
      clock: -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) },
      pause: ->(seconds) { sleep(seconds) }
    )
    receipt = AppleStoreProcessing.receipt(
      expected: expected, build: build, ipa_path: ipa, release_tag: release_tag,
      run_id: ENV.fetch('GITHUB_RUN_ID'), run_attempt: ENV.fetch('GITHUB_RUN_ATTEMPT'), uploaded: uploaded
    )
    File.write(ENV.fetch('APPLE_PROCESSING_RECEIPT_PATH'), JSON.pretty_generate(receipt) + "\n")
  end
end
