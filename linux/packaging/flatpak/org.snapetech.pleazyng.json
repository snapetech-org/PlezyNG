{
  "app-id": "org.snapetech.pleazyng",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "pleazyng",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=all",
    "--own-name=org.mpris.MediaPlayer2.org_snapetech_pleazyng",
    "--system-talk-name=org.freedesktop.NetworkManager",
    "--filesystem=xdg-run/os_media_controls_artwork:create",
    "--filesystem=xdg-run/discord-ipc-0",
    "--filesystem=xdg-run/discord-ipc-1",
    "--filesystem=xdg-run/discord-ipc-2",
    "--filesystem=xdg-run/discord-ipc-3",
    "--filesystem=xdg-run/discord-ipc-4",
    "--filesystem=xdg-run/discord-ipc-5",
    "--filesystem=xdg-run/discord-ipc-6",
    "--filesystem=xdg-run/discord-ipc-7",
    "--filesystem=xdg-run/discord-ipc-8",
    "--filesystem=xdg-run/discord-ipc-9",
    "--filesystem=xdg-run/app/com.discordapp.Discord:ro",
    "--env=GTK_USE_PORTAL=1"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "pleazyng",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a bundle /app/pleazyng",
        "install -Dm755 pleazyng /app/bin/pleazyng",
        "install -Dm644 org.snapetech.pleazyng.desktop /app/share/applications/org.snapetech.pleazyng.desktop",
        "install -Dm644 org.snapetech.pleazyng.metainfo.xml /app/share/metainfo/org.snapetech.pleazyng.metainfo.xml",
        "install -Dm644 pleazyng.png /app/share/icons/hicolor/512x512/apps/org.snapetech.pleazyng.png",
        "chmod 755 /app/pleazyng/pleazyng.sh",
        "if test -f /app/pleazyng/lib/crashpad_handler; then chmod 755 /app/pleazyng/lib/crashpad_handler; fi",
        "python3 relocate-caches.py /app/pleazyng"
      ],
      "sources": [
        { "type": "dir", "path": "bundle", "dest": "bundle" },
        { "type": "file", "path": "pleazyng" },
        { "type": "file", "path": "relocate-caches.py" },
        { "type": "file", "path": "org.snapetech.pleazyng.desktop" },
        { "type": "file", "path": "org.snapetech.pleazyng.metainfo.xml" },
        { "type": "file", "path": "pleazyng.png" }
      ]
    }
  ]
}
