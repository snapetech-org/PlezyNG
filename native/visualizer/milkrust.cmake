# Runtime artifacts are produced on private JIT before Flutter configuration.
option(PLEZY_VISUALIZER_REQUIRE_MILKRUST "Require the bundled native visualization runtime" ON)
set(PLEZY_VISUALIZER_MILKRUST_LIBRARY "" CACHE FILEPATH "Qualified native MilkRust shared library")
set(PLEZY_VISUALIZER_MILKRUST_SHA256 "" CACHE STRING "Reviewed MilkRust library SHA-256")
set(PLEZY_VISUALIZER_MILKRUST_SOURCE_ARCHIVE "" CACHE FILEPATH "Exact corresponding-source archive")
set(PLEZY_VISUALIZER_MILKRUST_SOURCE_SHA256 "" CACHE STRING "Reviewed corresponding-source SHA-256")

function(plezy_install_milkrust runtime_name)
  if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "MilkRust artifact receipts require CMake 3.19 or newer")
  endif()
  set(bundle "${CMAKE_SOURCE_DIR}/../build/visualizer-native")
  if(NOT PLEZY_VISUALIZER_MILKRUST_LIBRARY AND EXISTS "${bundle}/milkrust-build.json")
    file(READ "${bundle}/milkrust-build.json" receipt)
    file(READ "${CMAKE_SOURCE_DIR}/../native/visualizer/sources.lock.json" source_lock)
    string(JSON built_revision GET "${receipt}" sourceRevision)
    string(JSON expected_revision GET "${source_lock}" milkrust commit)
    if(NOT built_revision STREQUAL expected_revision)
      message(FATAL_ERROR "Staged MilkRust runtime differs from the app source pin")
    endif()
    set(PLEZY_VISUALIZER_MILKRUST_LIBRARY "${bundle}/${runtime_name}")
    string(JSON PLEZY_VISUALIZER_MILKRUST_SHA256 GET "${receipt}" files "${runtime_name}")
    set(PLEZY_VISUALIZER_MILKRUST_SOURCE_ARCHIVE "${bundle}/assets/visualizer-notices/milkrust-source.tar.gz")
    string(JSON PLEZY_VISUALIZER_MILKRUST_SOURCE_SHA256 GET "${receipt}" files "assets/visualizer-notices/milkrust-source.tar.gz")
    string(JSON notice_sha GET "${receipt}" files "assets/visualizer-notices/MILKRUST-NOTICES.txt")
    file(SHA256 "${bundle}/assets/visualizer-notices/MILKRUST-NOTICES.txt" actual_notice)
    if(NOT notice_sha STREQUAL actual_notice)
      message(FATAL_ERROR "Staged MilkRust notices differ from the build receipt")
    endif()
    install(FILES "${bundle}/assets/visualizer-notices/MILKRUST-NOTICES.txt" "${bundle}/milkrust-build.json"
      DESTINATION "${INSTALL_BUNDLE_DATA_DIR}/visualizer-notices" COMPONENT Runtime)
  endif()
  if(NOT PLEZY_VISUALIZER_MILKRUST_LIBRARY)
    if(PLEZY_VISUALIZER_REQUIRE_MILKRUST)
      message(FATAL_ERROR "MilkRust runtime is missing: run scripts/visualizer/build_runtime.py on private JIT before Flutter")
    endif()
    return()
  endif()
  foreach(artifact IN ITEMS LIBRARY SOURCE_ARCHIVE)
    set(path "${PLEZY_VISUALIZER_MILKRUST_${artifact}}")
    if(artifact STREQUAL "LIBRARY")
      set(expected "${PLEZY_VISUALIZER_MILKRUST_SHA256}")
    else()
      set(expected "${PLEZY_VISUALIZER_MILKRUST_SOURCE_SHA256}")
    endif()
    string(LENGTH "${expected}" digest_length)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR NOT digest_length EQUAL 64 OR
       NOT expected MATCHES "^[a-fA-F0-9]+$")
      message(FATAL_ERROR "MilkRust ${artifact} requires an existing artifact and a reviewed SHA-256")
    endif()
    file(SHA256 "${path}" actual)
    string(TOLOWER "${expected}" expected)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "MilkRust ${artifact} digest differs from the configured pin")
    endif()
  endforeach()
  # Remove first: native artifacts can have identical timestamp and file size.
  install(CODE "file(REMOVE \"${INSTALL_BUNDLE_LIB_DIR}/${runtime_name}\")" COMPONENT Runtime)
  install(FILES "${PLEZY_VISUALIZER_MILKRUST_LIBRARY}"
    DESTINATION "${INSTALL_BUNDLE_LIB_DIR}" RENAME "${runtime_name}" COMPONENT Runtime)
  install(FILES "${PLEZY_VISUALIZER_MILKRUST_SOURCE_ARCHIVE}"
    DESTINATION "${INSTALL_BUNDLE_DATA_DIR}/visualizer-notices/source" COMPONENT Runtime)
  install(DIRECTORY "${CMAKE_SOURCE_DIR}/../native/visualizer/notices/"
    DESTINATION "${INSTALL_BUNDLE_DATA_DIR}/visualizer-notices" COMPONENT Runtime)
  install(FILES "${CMAKE_SOURCE_DIR}/../native/visualizer/sources.lock.json"
    DESTINATION "${INSTALL_BUNDLE_DATA_DIR}/visualizer-notices" COMPONENT Runtime)
endfunction()
