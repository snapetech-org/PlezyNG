option(PLEZY_BUILD_VISUALIZER_PROCESS_TESTS "Build isolated-renderer protocol and fault cases" OFF)
if(PLEZY_BUILD_VISUALIZER_PROCESS_TESTS)
  enable_testing()
  add_executable(visualizer_render_process_test
    "${CMAKE_CURRENT_LIST_DIR}/../../test/native/visualizer_render_process_test.cc")
  apply_standard_settings(visualizer_render_process_test)
  target_compile_features(visualizer_render_process_test PRIVATE cxx_std_17)
  if(WIN32)
    target_compile_definitions(visualizer_render_process_test PRIVATE NOMINMAX)
    target_link_libraries(visualizer_render_process_test PRIVATE bcrypt)
  else()
    target_compile_definitions(visualizer_render_process_test PRIVATE _GNU_SOURCE)
    target_link_libraries(visualizer_render_process_test PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
  endif()
  add_test(NAME visualizer_render_process_test COMMAND visualizer_render_process_test)
  set_tests_properties(visualizer_render_process_test PROPERTIES TIMEOUT 60)
endif()
