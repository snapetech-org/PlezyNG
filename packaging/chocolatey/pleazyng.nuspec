    <iconUrl>https://rawcdn.githack.com/snapetech-org/pleazyng/9e9745362e9d8a4386a076ade2debdcce9de7c28/assets/branding/web/app-icon-180.png</iconUrl>
    <packageSourceUrl>https://github.com/snapetech-org/pleazyng/tree/main/packaging/chocolatey</packageSourceUrl>
    <projectSourceUrl>https://github.com/snapetech-org/pleazyng</projectSourceUrl>
