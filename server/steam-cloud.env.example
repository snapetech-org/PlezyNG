# Disabled until Valve approves a client and specific AppIDs. A Steam Web API
# key or OpenID/catalog connection does not grant Cloud file access.
# Register exactly ${OAUTH_BASE_URL}/auth/steam-cloud/callback with Valve.
STEAM_CLOUD_CLIENT_ID=
# Comma-separated uint32 AppIDs explicitly approved for read_cloud.
STEAM_CLOUD_READ_APPIDS=
# Subset of READ_APPIDS explicitly approved for write_cloud. Empty = read only.
STEAM_CLOUD_WRITE_APPIDS=
# Exact HTTPS storage DNS names observed/approved for this integration; no
# wildcards, IP literals, ports or URLs. Do not accept a user-supplied host.
STEAM_CLOUD_STORAGE_HOSTS=
