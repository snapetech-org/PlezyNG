# Optional, disabled by default. Requires the same single-process HTTPS server
# and Steam catalog admission as the app's linked account.
# Read docs/games/STEAM_FAMILIES.md before enabling: QR approval creates a
# temporary broader Steam account session. The trusted server keeps its tokens
# only in memory and limits operations to explicitly reviewed family changes.
# No publisher key or Valve Cloud client ID grants Families authority.
STEAM_FAMILIES_ENABLED=false
