# Opt in only after provisioning TLS, capacity and private-JIT/device checks.
# Must use the same server process as Steam OpenID/catalog grants.
STEAM_STREAM_RELAY_ENABLED=false
# Per-direction bandwidth cap, 1..64 MiB/s. Default preserves existing limits.
# Provision uplink/egress capacity before increasing for UHD/Pyrowave.
STEAM_STREAM_RELAY_MIB_PER_SECOND=8
# Empty = encrypted WSS forwarding only. To enable direct UDP hole punching,
# expose this same UDP port on the relay's public hostname (1024..65535), using
# steam-relay.compose.yml or an equivalent container/network rule.
STEAM_STREAM_RELAY_UDP_PORT=
# App build flags (not server environment variables):
# --dart-define=PLEZY_SERVER_BASE_URL=https://your-approved-server.example
# --dart-define=PLEZY_STEAM_RELAY_URL=https://your-approved-server.example
# The origins must match; catalog admission tokens are never sent elsewhere.
